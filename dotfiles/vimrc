" ~/.vimrc do omakuba
" Vim para edições rápidas no terminal. Enxuto e sem surpresa.

set nocompatible
filetype plugin indent on
syntax enable

set encoding=utf-8

" Aparência
set number
set ruler
set showcmd
set laststatus=2
set cursorline
set signcolumn=no
set background=dark
if has('termguicolors')
  set termguicolors
  silent! colorscheme habamax        " paleta sóbria, combina com o terminal
endif
set visualbell t_vb=                 " sem bipe piscando

" Movimento e busca
set ignorecase
set smartcase
set incsearch
set hlsearch
set scrolloff=5
set sidescrolloff=8
set wrap
set linebreak
set display+=lastline

" Edição
set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4
set smartindent
set autoindent
set backspace=indent,eol,start
set updatetime=300
set history=1000

" Clipboard do sistema
if has('clipboard')
  set clipboard=unnamedplus
endif

" Undo persistente
set undofile
if !isdirectory(expand('~/.vim/undo'))
  call mkdir(expand('~/.vim/undo'), 'p')
endif

" Janelas
set splitbelow
set splitright
set equalalways
